# Build Kylin/Ubuntu .deb packages from macOS via Docker (amd64 or arm64).
FROM node:20-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-gi \
    python3-gi-cairo \
    gir1.2-gtk-3.0 \
    gir1.2-webkit2-4.0 \
    libwebkit2gtk-4.0-37 \
    libgtk-3-0 \
    libnotify4 \
    dpkg-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
