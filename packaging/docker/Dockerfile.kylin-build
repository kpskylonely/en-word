# Build .deb against glibc 2.31 (Ubuntu 20.04) for Kylin V10.
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHON=python3.10

ARG NODE_VERSION=20.18.3
ARG TARGETARCH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      python3.10 python3.10-dev python3.10-venv python3.10-distutils \
      build-essential pkg-config \
      meson ninja-build \
      libffi-dev libglib2.0-dev libgirepository1.0-dev gobject-introspection \
      libcairo2-dev libpango1.0-dev libgtk-3-dev \
      gir1.2-gtk-3.0 gir1.2-webkit2-4.0 \
      libwebkit2gtk-4.0-37 libgtk-3-0 libnotify4 dpkg-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bootstrap.pypa.io/get-pip.py | python3.10 \
    && python3.10 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3.10 -m pip install --no-cache-dir pycairo PyGObject

RUN case "${TARGETARCH}" in \
      amd64) NODE_ARCH=x64 ;; \
      arm64) NODE_ARCH=arm64 ;; \
      *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1 \
    && node --version \
    && npm --version

WORKDIR /app
